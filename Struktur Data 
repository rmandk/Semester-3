      "execution_count": null,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "5 < 3 = False\n",
            "5 > 3 = True\n",
            "5 <= 3 = False\n",
            "5 >= 3 = True\n",
            "5 == 3 = False\n",
            "5 != 3 = True\n"
          ]
